# ─────────────────────────────────────────────────────────────────────────────
# .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing & Coverage
/coverage

# Production Builds
/build
/dist

# Environment & Secrets (CRITICAL: Never commit secrets)
.env
.env*.local
.env.development
.env.production
.env.staging
*.pem
*.key
*.cert

# Vercel & Deployment metadata
.vercel

# Operating System & IDE Files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
